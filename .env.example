# Copy to .env and uncomment only what you need. Everything is optional:
# keys can also be added later in the app (Settings → Providers) and are
# persisted in the Docker volume.
#
# Do not leave empty KEY= lines: the app treats a set-but-empty variable
# as a present key. Comment a line out to disable it.

# Host port for docker compose (the container always listens on 3000).
LH_PORT=3000

# ─── Deployment mode ────────────────────────────────────────────────────────
# desktop        Electron shell (set automatically by the desktop app)
# single-user    this dev/self-hosted profile — shared stores, no accounts
# multiuser-web  Clerk-authenticated, per-account Linux identities
#
# Leave it unset for desktop/single-user. multiuser-web is NEVER inferred from
# the presence of Clerk keys: it must be selected here explicitly. An unknown
# value is refused at startup — it does not fall back to single-user. Startup
# also refuses unless every requirement below is present and the container
# root filesystem is read-only.
# LH_DEPLOYMENT_MODE=multiuser-web

# Required in multiuser-web. Ignored, with a warning, in other profiles.
# Add these only in your host .env — never commit.
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Canonical browser origins (scheme + host + optional port; comma-separated).
# HTTP is permitted only for localhost development origins.
# LH_CLERK_AUTHORIZED_PARTIES=https://learn.example.com

# ─── multiuser-web layout (defaults shown; each is a separate mount) ────────
# LH_ACCOUNT_ROOT=/data/accounts          # account homes (per-account UID/GID)
# LH_REGISTRY_DIR=/data/registry          # controller-only registry + id ledger
# LH_INSTANCE_STATE_DIR=/data/instance    # controller-only keys/shared policy
# LH_STAGING_DIR=/data/staging            # root-locked upload/import staging
# LH_SNAPSHOT_DIR=/data/snapshots         # root-controlled export snapshots
# LH_PRIVATE_WORK_DIR=/data/private-work  # per-account temp/cache roots
# LH_CONTROLLER_IPC=/run/lh/controller.sock
# LH_HELPER_IPC=/run/lh/helper.sock

# Account identity window (system users are never account identities).
# LH_ACCOUNT_UID_MIN=30000
# LH_ACCOUNT_UID_MAX=39999
# LH_ACCOUNT_GID_MIN=30000
# LH_ACCOUNT_GID_MAX=39999

# The unprivileged identity the web server itself runs as (defaults match the
# image's `USER node`). Readiness refuses any designated root the web identity
# can reach or modify, and refuses to start if this declaration does not match
# the identity the process actually runs as. Must lie OUTSIDE the window above.
# LH_WEB_UID=1000
# LH_WEB_GID=1000

# ─── multiuser-web resource limits (ALL REQUIRED, no defaults) ──────────────
# State the real capacity of this host; the multi-user profile refuses to start
# without every one of these.
# LH_ACCOUNT_MAX_PROCESSES=64
# LH_ACCOUNT_MAX_CPU_MILLICORES=2000
# LH_ACCOUNT_MAX_MEMORY_MB=2048
# LH_ACCOUNT_MAX_CONCURRENT_JOBS=4
# LH_ACCOUNT_MAX_DISK_MB=4096
# LH_GLOBAL_MAX_ACTIVE_ACCOUNTS=20
# LH_GLOBAL_MAX_ACTIVE_WORKERS=20
# LH_GLOBAL_MAX_STREAMS=60
# LH_GLOBAL_MAX_PROVIDER_CONNECTIONS=40
# LH_GLOBAL_MAX_ARCHIVE_JOBS=2
# LH_GLOBAL_MAX_TEMP_BYTES=2147483648

# Required when accessing the app through a domain or reverse proxy.
# Comma-separated exact host names; no protocol, port or path.
# LH_ALLOWED_HOSTS=learn.example.com

# 1 = also install Chromium (demo verification); 0 = bare-minimum server.
WITH_CHROMIUM=0

# LLM providers (at least one is needed to run a session; OpenRouter is
# the default engine).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# Optional research / dictation services.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# FIRECRAWL_API_KEY=
# DEEPGRAM_API_KEY=
