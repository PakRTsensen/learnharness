# Copy to .env and uncomment only what you need. Everything is optional:
# keys can also be added later in the app (Settings → Providers) and are
# persisted in the Docker volume.
#
# Do not leave empty KEY= lines: the app treats a set-but-empty variable
# as a present key. Comment a line out to disable it.

# Host port for docker compose (the container always listens on 3000).
LH_PORT=3000

# Required when accessing the app through a domain or reverse proxy.
# Comma-separated exact host names; no protocol, port or path.
# LH_ALLOWED_HOSTS=learn.example.com

# 1 = also install Chromium (demo verification); 0 = bare-minimum server.
WITH_CHROMIUM=0

# LLM providers (at least one is needed to run a session; OpenRouter is
# the default engine).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# Optional research / dictation services.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# FIRECRAWL_API_KEY=
# DEEPGRAM_API_KEY=
