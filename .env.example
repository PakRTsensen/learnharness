# Copy to .env and uncomment only what you need. Everything is optional:
# keys can also be added later in the app (Settings → Providers) and are
# persisted in the Docker volume.
#
# Do not leave empty KEY= lines: the app treats a set-but-empty variable
# as a present key. Comment a line out to disable it.

# Host port for docker compose (the container always listens on 3000).
LH_PORT=3000

# Required when accessing the app through a domain or reverse proxy.
# Comma-separated exact host names; no protocol, port or path.
# LH_ALLOWED_HOSTS=learn.example.com

# 1 = also install Chromium (demo verification); 0 = bare-minimum server.
WITH_CHROMIUM=0

# ─── Multiuser web (Milestone 1) ───────────────────────────────────────────
# The default deployment remains the historical single-user web app. The
# multiuser composition is selected explicitly and fails closed:
#
#   LH_DEPLOYMENT_MODE=multiuser-web
#
# It requires a read-only root filesystem declaration and designated writable
# mounts. Paths are HOST paths, never account-controlled values. Docker's
# current entrypoint creates the default /data subdirectories; a production
# Phase 3 deployment will replace this with root-helper-created mounts.
#
# LH_DEPLOYMENT_MODE=multiuser-web
# LH_READ_ONLY_ROOT_FS=1
# LH_WRITABLE_MOUNTS=/data
# LH_ACCOUNT_ROOT=/data/accounts
# LH_CONTROLLER_STATE_DIR=/data/controller
# LH_STAGING_DIR=/data/staging
# LH_SNAPSHOT_DIR=/data/snapshots
# LH_PRIVATE_WORK_DIR=/data/work
# LH_UID_RANGE_START=200000
# LH_UID_RANGE_END=200999
# LH_GID_RANGE_START=200000
# LH_GID_RANGE_END=200999
# LH_MAX_ACTIVE_ACCOUNTS=20
# LH_MAX_ACTIVE_WORKERS=40
# LH_MAX_STREAMS=100
# LH_MAX_ARCHIVE_JOBS=2
# LH_MAX_PROVIDER_CONNECTIONS=32
# LH_MAX_TEMPORARY_BYTES=10737418240
# LH_SESSION_TTL_SECONDS=43200
#
# Authentication is runtime-only: no NEXT_PUBLIC_* key is baked at build time.
# Choose exactly one provider.
#
# A) LOCAL / OFFLINE SIMULATION — no Clerk account, no network. It mints the
#    same signed session cookie shape; it is not password authentication.
#    LH_ALLOW_LOCAL_AUTH=1 is mandatory when NODE_ENV=production (offline
#    Docker demos). Use 32+ random characters; never commit real secrets.
#
# LH_AUTH_PROVIDER=local
# LH_ALLOW_LOCAL_AUTH=1
# LH_LOCAL_AUTH_SECRET=
# LH_BOOTSTRAP_SECRET=
# # or mount a file instead (the environment value wins when both are set):
# LH_BOOTSTRAP_SECRET_FILE=/run/secrets/lh-bootstrap
#
# B) CLERK — session tokens are verified at runtime against the issuer/JWKS.
#    The controller never trusts a client-supplied subject. Set the public
#    origin so Clerk's `azp` claim can be checked. The webhook secret is only
#    needed for Clerk lifecycle events (user.deleted starts disablement).
#
# LH_AUTH_PROVIDER=clerk
# LH_SESSION_SECRET=
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# LH_APP_ORIGIN=https://learn.example.com
# CLERK_AUDIENCE=
# CLERK_AUTHORIZED_PARTIES=https://learn.example.com
# CLERK_SESSION_COOKIE=__session
# CLERK_SIGN_IN_URL=
# CLERK_SIGN_UP_URL=
# CLERK_WEBHOOK_SECRET=whsec_...
#
# First-administrator bootstrap: sign in, open /first-admin, and submit the
# host-issued secret once. Success permanently consumes it and opens ordinary
# registration. Until then registration and legacy claim stay closed.
#
# Milestone 1 gate: chats, graph, files, plugins, and their APIs return 503 in
# multiuser mode. Only authentication, bootstrap, account status, deletion
# recovery, sign-out, and the verified Clerk webhook are reachable.

# LLM providers (at least one is needed to run a session; OpenRouter is
# the default engine).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=

# Optional research / dictation services.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# FIRECRAWL_API_KEY=
# DEEPGRAM_API_KEY=
